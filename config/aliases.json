{
  "py": "python",
  "py3": "python3",
  "pipls": "python -m pip list",
  "pipu": "python -m pip install --upgrade",
  "..": "cd ..",
  "...": "cd ../..",
  "....": "cd ../../..",
  "c": "clear",
  "ll": "eza -lah --icons --group-directories-first (fallback: ls -lah)",
  "la": "eza -lah --icons --group-directories-first --all (fallback: ls -la)",
  "g": "git",
  "gs": "git status --short --branch",
  "gst": "git status",
  "ga": "git add",
  "gaa": "git add -A",
  "gd": "git diff",
  "gds": "git diff --staged",
  "gl": "git log --oneline --decorate -12",
  "gll": "git log --graph --oneline --decorate --all",
  "gco": "git checkout",
  "gsw": "git switch",
  "gcm": "git commit -m",
  "gpl": "git pull --ff-only",
  "gps": "git push",
  "gpf": "git push --force-with-lease",
  "gcl": "git clone",
  "lg": "lazygit (when installed)",
  "ff": "fzf (when installed)",
  "txs": "tx status",
  "txd": "tx doctor",
  "txe": "TERMAX Explorer; use --sixel for SIXEL previews",
  "txp": "TERMAX Pulse",
  "pyd": "python -m pdb",
  "pyi": "python -i",
  "pyc": "python -m compileall -q .",
  "pytest": "python -m pytest",
  "pipup": "python -m pip install --upgrade pip",
  "pipout": "python -m pip freeze",
  "ni": "npm install",
  "nid": "npm install --save-dev",
  "nr": "npm run",
  "nrd": "npm run dev",
  "nrb": "npm run build",
  "nrt": "npm test",
  "dus": "du -sh ./* | sort -h",
  "du1": "du -h --max-depth=1 . | sort -h",
  "dfh": "df -h",
  "psg": "ps -ef | grep -i",
  "tree2": "tree -L 2",
  "tree3": "tree -L 3",
  "jfmt": "python -m json.tool",
  "gss": "git status --short",
  "glog": "git log --graph --oneline --decorate -20",
  "gshow": "git show --stat",
  "pi": "python -m pip install",
  "pu": "python -m pip uninstall",
  "pishow": "python -m pip show",
  "pifreeze": "python -m pip freeze",
  "pir": "python -m pip install -r requirements.txt",
  "pireq": "python -m pip freeze > requirements.txt",
  "pki": "pkg install",
  "pkui": "pkg uninstall",
  "pks": "pkg search",
  "pkl": "pkg list-installed",
  "pkup": "pkg update && pkg upgrade",
  "pkclean": "pkg clean",
  "pkinfo": "pkg show",
  "sixelon": "export TERMAX_SIXEL=1",
  "sixeloff": "unset TERMAX_SIXEL"
}
